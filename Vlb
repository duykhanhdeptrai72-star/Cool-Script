local function createMobileBtn(txt, pos, color, func)
    local b = Instance.new("TextButton")
    b.Size = UDim2.new(0, 65, 0, 42)
    b.Position = pos
    b.BackgroundColor3 = color
    b.Text = txt
    b.TextColor3 = Color3.new(1,1,1)
    b.Font = Enum.Font.GothamBold
    b.Parent = btnContainer
    Instance.new("UICorner", b)
    
    b.MouseButton1Click:Connect(function()
        -- KIỂM TRA KHÓA TRƯỚC KHI CHẠY HÀM
        if not isLocked then
            func()
        else
            -- Nếu đang khóa, chỉ rung nhẹ để báo hiệu, KHÔNG thực hiện hành động
            local tween = TweenService:Create(b, TweenInfo.new(0.05, Enum.EasingStyle.Quart, Enum.EasingDirection.Out, 0, true), {Rotation = 5})
            tween:Play()
        end
    end)
end

