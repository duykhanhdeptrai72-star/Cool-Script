mobileBtnContainer.Parent = screenGui

local function createMobileBtn(text, pos, color, func)
    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(0, 60, 0, 35)
    btn.Position = pos
    btn.BackgroundColor3 = color
    btn.Text = text
    btn.TextColor3 = Color3.new(1,1,1)
    btn.Font = Enum.Font.GothamBold
    btn.TextSize = 12
    btn.Parent = mobileBtnContainer
    Instance.new("UICorner", btn)
    
    local connections = {}
    connections.click = btn.MouseButton1Click:Connect(func)
    
    -- Xử lý giữ nút cho Tăng/Giảm
    connections.down = btn.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            local holding = true
            local upConn; upConn = btn.InputEnded:Connect(function(input2)
                if input2.UserInputType == Enum.UserInputType.MouseButton1 or input2.UserInputType == Enum.UserInputType.Touch then
                    holding = false
                    upConn:Disconnect()
                end
            end)
            task.spawn(function()
                task.wait(0.5) -- Chờ trước khi bắt đầu lặp
                while holding do
                    func()
                    task.wait(0.1)
                end
            end)
        end
    end)
    return btn
end

