local UserInputService = game:GetService("UserInputService")
local RunService = game:GetService("RunService")
local ContextActionService = game:GetService("ContextActionService")
local Players = game:GetService("Players")

local player = Players.LocalPlayer
local camera = workspace.CurrentCamera
local targetJumpForce = 65 
local targetSpeedMult = 0.15 
local magnetRange = 25 
local customBallPath = "Workspace.Ball.BallPart"
local hasDoubleJumped = false
local stopMomentumActive = false
local connections = {}

-- --- GIAO DIỆN (GUI) ---
local screenGui = Instance.new("ScreenGui")
screenGui.Name = "Volleyball_MobileFix_V17"
screenGui.ResetOnSpawn = false
screenGui.Parent = player:WaitForChild("PlayerGui")

local mainFrame = Instance.new("Frame")
mainFrame.Size = UDim2.new(0, 180, 0, 160)
mainFrame.Position = UDim2.new(0, 10, 0.15, 0)
mainFrame.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
mainFrame.BackgroundTransparency = 0.5
mainFrame.Parent = screenGui
Instance.new("UICorner", mainFrame)

local function createLabel(text, pos, color)
    local lbl = Instance.new("TextLabel")
    lbl.Size = UDim2.new(1, -10, 0, 25)
    lbl.Position = pos
    lbl.BackgroundTransparency = 1
    lbl.TextColor3 = color or Color3.new(1,1,1)
    lbl.TextSize = 12
    lbl.Font = Enum.Font.GothamBold
    lbl.Text = text
    lbl.Parent = mainFrame
    return lbl
end

local jumpLabel = createLabel("Jump: " .. targetJumpForce, UDim2.new(0, 10, 0, 10))
local speedLabel = createLabel("Speed: " .. targetSpeedMult, UDim2.new(0, 10, 0, 40))
local pathBox = Instance.new("TextBox")
pathBox.Size = UDim2.new(1, -20, 0, 30)
pathBox.Position = UDim2.new(0, 10, 0, 75)
pathBox.PlaceholderText = "Dán Path bóng..."
pathBox.Text = customBallPath
pathBox.BackgroundColor3 = Color3.fromRGB(50, 50, 50)
pathBox.TextColor3 = Color3.new(1,1,1)
pathBox.Parent = mainFrame
pathBox.FocusLost:Connect(function() customBallPath = pathBox.Text end)

-- --- CHỨC NĂNG MOBILE (NÚT TRÒN RIÊNG BIỆT) ---

-- 1. Nút Dừng Quán Tính (STOP)
ContextActionService:BindAction("StopMomentum", function(actionName, inputState)
    if inputState == Enum.UserInputState.Begin then
        stopMomentumActive = not stopMomentumActive
        warn("Anti-Momentum: " .. tostring(stopMomentumActive))
    end
end, true, Enum.KeyCode.S)
ContextActionService:SetTitle("StopMomentum", "STOP")
ContextActionService:SetPosition("StopMomentum", UDim2.new(0.5, 70, 0, -70))

-- 2. Nút Xóa Tường (WALL)
ContextActionService:BindAction("ClearWalls", function(actionName, inputState)
    if inputState == Enum.UserInputState.Begin then
        for _, v in pairs(workspace:GetDescendants()) do
            if v:IsA("BasePart") and v.Transparency >= 0.9 then v.CanCollide = false end
        end
    end
end, true, Enum.KeyCode.L)
ContextActionService:SetTitle("ClearWalls", "WALL")
ContextActionService:SetPosition("ClearWalls", UDim2.new(0.5, 70, 0, -140))

-- --- LOGIC CHÍNH ---
connections.heartbeat = RunService.Heartbeat:Connect(function()
    local char = player.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    local hum = char and char:FindFirstChild("Humanoid")

    if hrp and hum then
        -- Xử lý Momentum (Bấm S hoặc bật nút STOP)
        if (stopMomentumActive or UserInputService:IsKeyDown(Enum.KeyCode.S)) and hum.FloorMaterial == Enum.Material.Air then
            hrp.AssemblyLinearVelocity = Vector3.new(0, hrp.AssemblyLinearVelocity.Y, 0)
        end

        -- Xử lý JumpPower & Speed
        if hum.MoveDirection.Magnitude > 0 then
            hrp.CFrame = hrp.CFrame + (hum.MoveDirection * targetSpeedMult)
        end
        
        -- Hút bóng từ Path
        local success, ball = pcall(function()
            local p = string.split(customBallPath, ".")
            local cur = game
            for i=1,#p do cur = cur:FindFirstChild(p[i]) end
            return cur
        end)

        if success and ball and ball:IsA("BasePart") then
            if (hrp.Position - ball.Position).Magnitude < magnetRange then
                ball.CFrame = ball.CFrame:Lerp(hrp.CFrame * CFrame.new(0, 2.6, -3.6), 0.3)
            end
        end

        -- Double Jump & Xoay Camera
        if hum.FloorMaterial ~= Enum.Material.Air then
            hasDoubleJumped = false
        else
            -- Tự động cho phép nhảy lần 2 khi nhấn Jump trên Mobile
            UserInputService.JumpRequest:Connect(function()
                if not hasDoubleJumped and hum.FloorMaterial == Enum.Material.Air then
                    hasDoubleJumped = true
                    hrp.AssemblyLinearVelocity = Vector3.new(hrp.AssemblyLinearVelocity.X, targetJumpForce, hrp.AssemblyLinearVelocity.Z)
                end
            end)
        end

        if hasDoubleJumped then
            local look = camera.CFrame.LookVector
            hrp.CFrame = hrp.CFrame:Lerp(CFrame.new(hrp.Position) * CFrame.Angles(0, math.atan2(-look.X, -look.Z), 0), 0.2)
        end
    end
end)

print("✅ V17 Mobile Fixed Loaded! Hãy kiểm tra các nút STOP/WALL hiện ra cạnh nút nhảy.")
