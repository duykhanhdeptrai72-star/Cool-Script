-- --- LOGIC XU LY QUY DAO VA VAT LY ---
local function getBall()
    local success, res = pcall(function()
        local parts = string.split(customBallPath, ".")
        local cur = game
        for i=1,#parts do cur = cur:FindFirstChild(parts[i]) end
        return cur
    end)
    return success and res or nil
end

connections.main = RunService.Heartbeat:Connect(function()
    if not isRunning then return end
    local char = player.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    local hum = char and char:FindFirstChild("Humanoid")

    if hrp and hum then
        -- 1. AUTOMATIC MOMENTUM (Chi khi di lui)
        if hum.FloorMaterial == Enum.Material.Air then
            -- Kiem tra huong di chuyen so voi huong nhin
            local dotProduct = hum.MoveDirection:Dot(hrp.CFrame.LookVector)
            if dotProduct < -0.25 or UserInputService:IsKeyDown(Enum.KeyCode.S) then
                -- Triet tieu van toc ngang, giu nguyen van toc roi (Y)
                hrp.AssemblyLinearVelocity = Vector3.new(0, hrp.AssemblyLinearVelocity.Y, 0)
            end
        end

        -- 2. SPEED CFRAME
        if hum.MoveDirection.Magnitude > 0 then
            hrp.CFrame = hrp.CFrame + (hum.MoveDirection * targetSpeedMult)
        end

        -- 3. SHIFTLOCK / DIRECTIONAL JUMP
        if hasDoubleJumped and hum.FloorMaterial == Enum.Material.Air then
            local look = camera.CFrame.LookVector
            local targetRotation = CFrame.new(hrp.Position) * CFrame.Angles(0, math.atan2(-look.X, -look.Z), 0)
            hrp.CFrame = hrp.CFrame:Lerp(targetRotation, 0.2)
        end
        
        -- Reset Double Jump khi chạm đất
        if hum.FloorMaterial ~= Enum.Material.Air then hasDoubleJumped = false end

        -- 4. MAGNET HITBOX (Universe Path)
        local ball = getBall()
        if ball and ball:IsA("BasePart") then
            local dist = (hrp.Position - ball.Position).Magnitude
            if dist < magnetRange then
                -- Hut bong ve phia truoc mat nhan vat
                ball.CFrame = ball.CFrame:Lerp(hrp.CFrame * CFrame.new(0, 2.5, -3.5), 0.3)
                
                -- Hieu ung Visual (Trang trong suot)
                local v = ball:FindFirstChild("V") or Instance.new("SelectionSphere", ball)
                v.Name = "V"
                v.Transparency = 0.8
                v.Color3 = Color3.new(1,1,1)
                v.Adornee = ball
            end
        end
        
        -- 5. CAP NHAT DO CAO LIEN TUC
        local rayParams = RaycastParams.new()
        rayParams.FilterType = Enum.RaycastFilterType.Exclude
        rayParams.FilterDescendantsInstances = {char}
        local ray = workspace:Raycast(hrp.Position, Vector3.new(0, -100, 0), rayParams)
        if ray then 
            heightLabel.Text = "➤ Độ cao: " .. math.floor(hrp.Position.Y - ray.Position.Y - 3) .. " Studs" 
        end
    end
end)

-- --- FIX LOI TU DONG NHAY (JUMP REQUEST) ---
connections.jump = UserInputService.JumpRequest:Connect(function()
    local char = player.Character
    local hum = char and char:FindFirstChild("Humanoid")
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    
    if hum and hrp and hum.FloorMaterial == Enum.Material.Air and not hasDoubleJumped then
        -- Cho phep Double Jump
        hasDoubleJumped = true
        hrp.AssemblyLinearVelocity = Vector3.new(hrp.AssemblyLinearVelocity.X, targetJumpForce, hrp.AssemblyLinearVelocity.Z)
    end
end)

