local UserInputService = game:GetService("UserInputService")
local RunService = game:GetService("RunService")
local ContextActionService = game:GetService("ContextActionService")
local Players = game:GetService("Players")

local player = Players.LocalPlayer
local camera = workspace.CurrentCamera
local targetJumpForce = 65 
local targetSpeedMult = 0.15 
local magnetRange = 25 
local customBallPath = "Workspace.Ball.BallPart"
local hasDoubleJumped = false
local stopMomentumActive = false
local connections = {}

-- --- GIAO DIỆN (GUI) ---
local screenGui = Instance.new("ScreenGui")
screenGui.Name = "Volleyball_Universe_V18"
screenGui.ResetOnSpawn = false
screenGui.Parent = player:WaitForChild("PlayerGui")

local mainFrame = Instance.new("Frame")
mainFrame.Size = UDim2.new(0, 200, 0, 220)
mainFrame.Position = UDim2.new(0, 15, 0.2, 0)
mainFrame.BackgroundColor3 = Color3.fromRGB(10, 10, 10)
mainFrame.BackgroundTransparency = 0.4
mainFrame.Parent = screenGui
Instance.new("UICorner", mainFrame)

local function createLabel(text, pos, color)
    local lbl = Instance.new("TextLabel")
    lbl.Size = UDim2.new(1, -10, 0, 25)
    lbl.Position = pos
    lbl.BackgroundTransparency = 1
    lbl.TextColor3 = color or Color3.new(1,1,1)
    lbl.TextSize = 12
    lbl.Font = Enum.Font.GothamBold
    lbl.Text = text
    lbl.Parent = mainFrame
    return lbl
end

local jumpLabel = createLabel("Lực nhảy: " .. targetJumpForce, UDim2.new(0, 10, 0, 10))
local speedLabel = createLabel("Tốc độ: " .. targetSpeedMult, UDim2.new(0, 10, 0, 40))
local magnetLabel = createLabel("Hitbox: " .. magnetRange, UDim2.new(0, 10, 0, 70), Color3.fromRGB(150, 200, 255))
local heightLabel = createLabel("Độ cao: 0 Studs", UDim2.new(0, 10, 0, 100), Color3.fromRGB(0, 255, 150))

-- Ô nhập Path (Quan trọng cho Universe)
local pathBox = Instance.new("TextBox")
pathBox.Size = UDim2.new(1, -20, 0, 35)
pathBox.Position = UDim2.new(0, 10, 0, 135)
pathBox.PlaceholderText = "Nhập Path (Dùng Dex)..."
pathBox.Text = customBallPath
pathBox.BackgroundColor3 = Color3.fromRGB(40, 40, 40)
pathBox.TextColor3 = Color3.new(1,1,1)
pathBox.TextSize = 10
pathBox.Parent = mainFrame
Instance.new("UICorner", pathBox)

pathBox.FocusLost:Connect(function(enter)
    if enter then customBallPath = pathBox.Text end
end)

-- --- MOBILE ACTION BUTTONS ---
local function handleMobileAction(name, state)
    if state == Enum.UserInputState.Begin then
        if name == "StopMomentum" then
            stopMomentumActive = not stopMomentumActive
        elseif name == "ClearWalls" then
            for _, v in pairs(workspace:GetDescendants()) do
                if v:IsA("BasePart") and v.Transparency >= 0.9 and v.CanCollide then v.CanCollide = false end
            end
        end
    end
end

ContextActionService:BindAction("StopMomentum", handleMobileAction, true, Enum.KeyCode.S)
ContextActionService:SetTitle("StopMomentum", "STOP")
ContextActionService:SetPosition("StopMomentum", UDim2.new(0.5, 70, 0, -70))

ContextActionService:BindAction("ClearWalls", handleMobileAction, true, Enum.KeyCode.L)
ContextActionService:SetTitle("ClearWalls", "WALL")
ContextActionService:SetPosition("ClearWalls", UDim2.new(0.5, 70, 0, -140))

-- --- LOGIC XỬ LÝ QUẢ BÓNG ---
local function getTargetBall()
    local success, result = pcall(function()
        local p = string.split(customBallPath, ".")
        local cur = game
        for i=1,#p do
            cur = cur:FindFirstChild(p[i])
            if not cur then return nil end
        end
        return cur
    end)
    return success and result or nil
end

-- --- VÒNG LẶP CHÍNH (Anti-Lag & Performance) ---
connections.heartbeat = RunService.Heartbeat:Connect(function()
    local char = player.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    local hum = char and char:FindFirstChild("Humanoid")

    if hrp and hum then
        -- 1. Anti-Momentum (S / STOP)
        if (stopMomentumActive or UserInputService:IsKeyDown(Enum.KeyCode.S)) and hum.FloorMaterial == Enum.Material.Air then
            hrp.AssemblyLinearVelocity = Vector3.new(0, hrp.AssemblyLinearVelocity.Y, 0)
        end

        -- 2. Tốc độ CFrame (Speed)
        if hum.MoveDirection.Magnitude > 0 then
            hrp.CFrame = hrp.CFrame + (hum.MoveDirection * targetSpeedMult)
        end
        
        -- 3. Hút bóng (Magnetic)
        local ball = getTargetBall()
        if ball and ball:IsA("BasePart") then
            local dist = (hrp.Position - ball.Position).Magnitude
            if dist < magnetRange then
                ball.CFrame = ball.CFrame:Lerp(hrp.CFrame * CFrame.new(0, 2.5, -3.5), 0.35)
                local v = ball:FindFirstChild("V") or Instance.new("SelectionSphere", ball)
                v.Name = "V"; v.Transparency = 0.8; v.Color3 = Color3.new(1,1,1); v.Adornee = ball
            end
        end

        -- 4. Double Jump & Xoay Camera
        if hum.FloorMaterial ~= Enum.Material.Air then
            hasDoubleJumped = false
        end
        
        if hasDoubleJumped and hum.FloorMaterial == Enum.Material.Air then
            local look = camera.CFrame.LookVector
            hrp.CFrame = hrp.CFrame:Lerp(CFrame.new(hrp.Position) * CFrame.Angles(0, math.atan2(-look.X, -look.Z), 0), 0.2)
        end

        -- 5. Cập nhật độ cao
        local ray = workspace:Raycast(hrp.Position, Vector3.new(0, -150, 0))
        if ray then heightLabel.Text = "Độ cao: " .. math.floor(hrp.Position.Y - ray.Position.Y - 3) .. " Studs" end
    end
end)

-- --- ĐIỀU KHIỂN PHÍM BẤM ---
connections.input = UserInputService.InputBegan:Connect(function(input, proc)
    if proc then return end
    local hrp = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
    local hum = player.Character and player.Character:FindFirstChild("Humanoid")

    if input.KeyCode == Enum.KeyCode.J then
        for _, c in pairs(connections) do c:Disconnect() end
        ContextActionService:UnbindAction("StopMomentum")
        ContextActionService:UnbindAction("ClearWalls")
        screenGui:Destroy()
        return
    end

    -- Nhảy & Double Jump
    if input.KeyCode == Enum.KeyCode.Space or input.UserInputType == Enum.UserInputType.Touch then
        if hum and hum.FloorMaterial == Enum.Material.Air and not hasDoubleJumped then
            hasDoubleJumped = true
            hrp.AssemblyLinearVelocity = Vector3.new(hrp.AssemblyLinearVelocity.X, targetJumpForce, hrp.AssemblyLinearVelocity.Z)
        end
    end

    -- Hotkeys
    if input.KeyCode == Enum.KeyCode.F5 then targetJumpForce = targetJumpForce + 2
    elseif input.KeyCode == Enum.KeyCode.F6 then targetJumpForce = math.max(0, targetJumpForce - 2)
    elseif input.KeyCode == Enum.KeyCode.KeypadPlus then targetSpeedMult = targetSpeedMult + 0.02
    elseif input.KeyCode == Enum.KeyCode.KeypadMinus then targetSpeedMult = math.max(0, targetSpeedMult - 0.02)
    elseif input.KeyCode == Enum.KeyCode.F8 then
        magnetRange = magnetRange + 10
        if magnetRange > 150 then magnetRange = 10 end
    end
    
    jumpLabel.Text = "Lực nhảy: " .. targetJumpForce
    speedLabel.Text = "Tốc độ: " .. string.format("%.2f", targetSpeedMult)
    magnetLabel.Text = "Hitbox: " .. magnetRange
end)

print("🚀 V18 Hybrid Universe Loaded!")
