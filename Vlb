end)
createBtn("KILL", UDim2.new(0,65,0,80), Color3.fromRGB(60, 60, 60), function() screenGui:Destroy() for _,c in pairs(connections) do c:Disconnect() end end)

-- --- LOGIC CORE ---
connections.loop = RunService.Heartbeat:Connect(function()
    local char = player.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    local hum = char and char:FindFirstChild("Humanoid")

    if hrp and hum then
        -- 1. Momentum CHỈ KHI ĐI LÙI
        if hum.FloorMaterial == Enum.Material.Air then
            local isMovingBack = hum.MoveDirection:Dot(hrp.CFrame.LookVector) < -0.2
            if isMovingBack or UserInputService:IsKeyDown(Enum.KeyCode.S) then
                hrp.AssemblyLinearVelocity = Vector3.new(0, hrp.AssemblyLinearVelocity.Y, 0)
            end
        end

        -- 2. Speed & Xoay Camera
        if hum.MoveDirection.Magnitude > 0 then
            hrp.CFrame = hrp.CFrame + (hum.MoveDirection * targetSpeedMult)
        end
        if hasDoubleJumped and hum.FloorMaterial == Enum.Material.Air then
            local look = camera.CFrame.LookVector
            hrp.CFrame = hrp.CFrame:Lerp(CFrame.new(hrp.Position) * CFrame.Angles(0, math.atan2(-look.X, -look.Z), 0), 0.2)
        end
        if hum.FloorMaterial ~= Enum.Material.Air then hasDoubleJumped = false end

        -- 3. Hút bóng Universe
        local success, ball = pcall(function()
            local p = string.split(customBallPath, ".")
            local cur = game
            for i=1,#p do cur = cur:FindFirstChild(p[i]) end
            return cur
        end)
        if success and ball and ball:IsA("BasePart") then
            if (hrp.Position - ball.Position).Magnitude < magnetRange then
                ball.CFrame = ball.CFrame:Lerp(hrp.CFrame * CFrame.new(0, 2.5, -3.5), 0.3)
            end
        end
        
        -- Cập nhật độ cao
        local ray = workspace:Raycast(hrp.Position, Vector3.new(0, -100, 0))
        if ray then heightLabel.Text = "Độ cao: " .. math.floor(hrp.Position.Y - ray.Position.Y - 3) end
    end
end)

-- Fix lỗi tự động nhảy
UserInputService.JumpRequest:Connect(function()
    local char = player.Character
    local hum = char and char:FindFirstChild("Humanoid")
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    if hum and hrp and hum.FloorMaterial == Enum.Material.Air and not hasDoubleJumped then
        hasDoubleJumped = true
        hrp.AssemblyLinearVelocity = Vector3.new(hrp.AssemblyLinearVelocity.X, targetJumpForce, hrp.AssemblyLinearVelocity.Z)
    end
end)
