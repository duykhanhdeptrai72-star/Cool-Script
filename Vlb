local UserInputService = game:GetService("UserInputService")
local RunService = game:GetService("RunService")
local Players = game:GetService("Players")

local player = Players.LocalPlayer
local camera = workspace.CurrentCamera
local targetJumpForce = 60 
local targetSpeedMult = 0.12 
local magnetRange = 25 
local customBallPath = "Workspace.Ball.BallPart"
local hasDoubleJumped = false
local isMobile = UserInputService.TouchEnabled -- Tự động nhận diện điện thoại
local connections = {}

-- --- GIAO DIỆN CHÍNH (GUI) ---
local screenGui = Instance.new("ScreenGui")
screenGui.Name = "Volleyball_Universal_V16"
screenGui.ResetOnSpawn = false
screenGui.Parent = player:WaitForChild("PlayerGui")

local mainFrame = Instance.new("Frame")
mainFrame.Size = UDim2.new(0, 200, 0, 240)
mainFrame.Position = UDim2.new(0, 10, 0.3, 0)
mainFrame.BackgroundColor3 = Color3.fromRGB(15, 15, 15)
mainFrame.BackgroundTransparency = 0.4
mainFrame.Parent = screenGui
Instance.new("UICorner", mainFrame)

local function createLabel(text, pos, color)
    local lbl = Instance.new("TextLabel")
    lbl.Size = UDim2.new(1, -10, 0, 20)
    lbl.Position = pos
    lbl.BackgroundTransparency = 1
    lbl.TextColor3 = color or Color3.fromRGB(255, 255, 255)
    lbl.TextSize = 12
    lbl.Font = Enum.Font.GothamBold
    lbl.Text = text
    lbl.Parent = mainFrame
    return lbl
end

local jumpLabel = createLabel("Lực nhảy: " .. targetJumpForce, UDim2.new(0, 10, 0, 10))
local speedLabel = createLabel("Tốc độ: " .. targetSpeedMult, UDim2.new(0, 10, 0, 35))
local magnetLabel = createLabel("Hitbox: " .. magnetRange, UDim2.new(0, 10, 0, 60), Color3.fromRGB(200, 200, 255))
local heightLabel = createLabel("Độ cao: 0", UDim2.new(0, 10, 0, 85), Color3.fromRGB(0, 255, 150))

-- Ô nhập Path
local pathBox = Instance.new("TextBox")
pathBox.Size = UDim2.new(1, -20, 0, 25)
pathBox.Position = UDim2.new(0, 10, 0, 115)
pathBox.PlaceholderText = "Dán Path bóng..."
pathBox.Text = customBallPath
pathBox.BackgroundColor3 = Color3.fromRGB(40, 40, 40)
pathBox.TextColor3 = Color3.fromRGB(255, 255, 255)
pathBox.TextSize = 10
pathBox.Parent = mainFrame
pathBox.FocusLost:Connect(function(enter) if enter then customBallPath = pathBox.Text end end)

-- --- HỆ THỐNG NÚT BẤM CHO MOBILE ---
local buttonContainer = Instance.new("Frame")
buttonContainer.Size = UDim2.new(0, 70, 0, 200)
buttonContainer.Position = UDim2.new(1, -80, 0.3, 0)
buttonContainer.BackgroundTransparency = 1
buttonContainer.Parent = screenGui

local function createMobileBtn(name, pos, color, func)
    local btn = Instance.new("TextButton")
    btn.Name = name
    btn.Size = UDim2.new(0, 60, 0, 40)
    btn.Position = pos
    btn.BackgroundColor3 = color
    btn.Text = name
    btn.TextColor3 = Color3.new(1,1,1)
    btn.Font = Enum.Font.GothamBold
    btn.TextSize = 12
    btn.Parent = buttonContainer
    Instance.new("UICorner", btn)
    btn.MouseButton1Click:Connect(func)
    return btn
end

-- Chức năng dừng quán tính (Nút S cho Mobile)
local stopMomentum = false
createMobileBtn("STOP", UDim2.new(0,0,0,0), Color3.fromRGB(255, 50, 50), function()
    stopMomentum = not stopMomentum
end)

createMobileBtn("WALL", UDim2.new(0,0,0,50), Color3.fromRGB(50, 150, 255), function()
    for _, obj in pairs(workspace:GetDescendants()) do
        if obj:IsA("BasePart") and obj.Transparency >= 0.9 and obj.CanCollide then obj.CanCollide = false end
    end
end)

createMobileBtn("KILL", UDim2.new(0,0,0,100), Color3.fromRGB(100, 100, 100), function()
    for _, c in pairs(connections) do c:Disconnect() end
    screenGui:Destroy()
end)

-- --- LOGIC VẬT LÝ ---
connections.heartbeat = RunService.Heartbeat:Connect(function()
    local char = player.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    local hum = char and char:FindFirstChild("Humanoid")
    
    if hrp and hum then
        -- Anti-Momentum (PC: giữ S | Mobile: Bật nút STOP)
        if (UserInputService:IsKeyDown(Enum.KeyCode.S) or stopMomentum) and hum.FloorMaterial == Enum.Material.Air then
            hrp.AssemblyLinearVelocity = Vector3.new(0, hrp.AssemblyLinearVelocity.Y, 0)
        end

        -- Hút bóng
        local pathParts = string.split(customBallPath, ".")
        local ball = game
        for i=1,#pathParts do if ball then ball = ball:FindFirstChild(pathParts[i]) end end
        
        if ball and ball:IsA("BasePart") then
            if (hrp.Position - ball.Position).Magnitude < magnetRange then
                ball.CFrame = ball.CFrame:Lerp(hrp.CFrame * CFrame.new(0, 2.5, -3.5), 0.35)
                local v = ball:FindFirstChild("V") or Instance.new("SelectionSphere", ball)
                v.Name = "V"; v.Transparency = 0.8; v.Color3 = Color3.new(1,1,1); v.Adornee = ball
            end
        end

        -- Xoay hướng & Speed
        if hum.MoveDirection.Magnitude > 0 then hrp.CFrame = hrp.CFrame + (hum.MoveDirection * targetSpeedMult) end
        if hasDoubleJumped and hum.FloorMaterial == Enum.Material.Air then
            local camLook = camera.CFrame.LookVector
            hrp.CFrame = hrp.CFrame:Lerp(CFrame.new(hrp.Position) * CFrame.Angles(0, math.atan2(-camLook.X, -camLook.Z), 0), 0.2)
        end
        if hum.FloorMaterial ~= Enum.Material.Air then hasDoubleJumped = false end
        
        local ray = workspace:Raycast(hrp.Position, Vector3.new(0, -150, 0))
        if ray then heightLabel.Text = "Độ cao: " .. math.floor(hrp.Position.Y - ray.Position.Y - 3) end
    end
end)

-- Nhảy Space (Vẫn dùng được nút Nhảy mặc định của Mobile)
connections.input = UserInputService.InputBegan:Connect(function(input, proc)
    if proc then return end
    local hrp = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
    local hum = char and char:FindFirstChild("Humanoid")
    if input.KeyCode == Enum.KeyCode.Space and hrp then
        if hum and hum.FloorMaterial == Enum.Material.Air and not hasDoubleJumped then
            hasDoubleJumped = true
            hrp.AssemblyLinearVelocity = Vector3.new(hrp.AssemblyLinearVelocity.X, targetJumpForce * 0.6, hrp.AssemblyLinearVelocity.Z)
        end
    end
end)
