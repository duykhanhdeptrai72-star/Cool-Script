createBtn("JMP -", UDim2.new(0,65,0,40), Color3.fromRGB(170, 0, 0), function() targetJumpForce = math.max(0, targetJumpForce - 2) jumpLabel.Text = "Nhảy: "..targetJumpForce end)
createBtn("WALL", UDim2.new(0,0,0,80), Color3.fromRGB(0, 120, 255), function() 
