local function createMobileBtn(txt, pos, color, func)
    local b = Instance.new("TextButton")
    b.Size = UDim2.new(0, 65, 0, 40)
    b.Position = pos
    b.BackgroundColor3 = color
    b.Text = txt
    b.TextColor3 = Color3.new(1,1,1)
    b.Font = Enum.Font.GothamBold
    b.Parent = btnContainer
    Instance.new("UICorner", b)
    
    b.MouseButton1Click:Connect(function()
        if not isLocked then
            func()
        else
            -- Hieu ung rung nhe khi nut dang khoa
            local origPos = b.Position
            b.Position = origPos + UDim2.new(0, 2, 0, 0)
            task.wait(0.05)
            b.Position = origPos
        end
    end)
end

