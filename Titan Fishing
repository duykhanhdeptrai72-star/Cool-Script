-- 2. GIAO DIỆN ĐIỀU KHIỂN
local screenGui = Instance.new("ScreenGui", player.PlayerGui)
screenGui.Name = "HungBon_Supreme_Protect"
screenGui.ResetOnSpawn = false

local mainFrame = Instance.new("Frame", screenGui)
mainFrame.Size = UDim2.new(0, 200, 0, 180)
mainFrame.Position = UDim2.new(0.05, 0, 0.2, 0)
mainFrame.BackgroundColor3 = Color3.fromRGB(15, 15, 15)
Instance.new("UICorner", mainFrame).CornerRadius = UDim.new(0, 10)

local uiStroke = Instance.new("UIStroke", mainFrame)
uiStroke.Color = Color3.fromRGB(0, 255, 150)
uiStroke.Thickness = 2

local function createBox(key, y)
    local box = Instance.new("TextBox", mainFrame)
    box.Size = UDim2.new(0.8, 0, 0, 25)
    box.Position = UDim2.new(0.1, 0, 0, y)
    box.Text = key .. " Delay: " .. delays[key]
    box.BackgroundColor3 = Color3.fromRGB(30, 30, 30)
    box.TextColor3 = Color3.new(1, 1, 1)
    Instance.new("UICorner", box)
    box.FocusLost:Connect(function()
        local v = tonumber(box.Text:match("%d+%.?%d*"))
        if v then delays[key] = v box.Text = key .. " Delay: " .. v end
    end)
end

createBox("Z", 30)
createBox("X", 60)
createBox("C", 90)

