-- 4. LOGIC SPAM CHIÊU (CƠ CHẾ MỚI ĐỂ ĐIỆN THOẠI NHẬN)
local function startSpamming()
    for _, k in pairs({"Z", "X", "C"}) do
        task.spawn(function()
            while enabled do
                -- Sử dụng tổ hợp các cách để đảm bảo Executor trên Mobile nhận lệnh
                if keypress then keypress(Enum.KeyCode[k]) end
                game:GetService("VirtualInputManager"):SendKeyEvent(true, Enum.KeyCode[k], false, game)
                task.wait(0.05)
                if keyrelease then keyrelease(Enum.KeyCode[k]) end
                game:GetService("VirtualInputManager"):SendKeyEvent(false, Enum.KeyCode[k], false, game)
                
                task.wait(delays[k])
            end
        end)
    end
end

toggleBtn.MouseButton1Click:Connect(function()
    enabled = not enabled
    toggleBtn.Text = enabled and "STOP" or "RUN"
    toggleBtn.BackgroundColor3 = enabled and Color3.fromRGB(255, 50, 50) or Color3.fromRGB(0, 255, 150)
    if enabled then startSpamming() end
end)

-- PC Support
UserInputService.InputBegan:Connect(function(i, p)
    if not p and i.KeyCode == Enum.KeyCode.E then
        enabled = not enabled
        if enabled then startSpamming() end
    end
end)

-- ANTI-BAN/KICK GIAI ĐOẠN ĐẦU (ẨN SCRIPT)
local mt = getrawmetatable(game)
local old = mt.__namecall
setreadonly(mt, false)
mt.__namecall = newcclosure(function(self, ...)
    local method = getnamecallmethod()
    if method == "Kick" or method == "kick" then
        warn("Script đã chặn nỗ lực Kick từ Game!")
        return nil
    end
    return old(self, ...)
end)
setreadonly(mt, true)

