-- 3. HAI NÚT MOBILE TRÒN SIÊU ĐẸP
local function createCircleBtn(text, pos, color)
    local btn = Instance.new("TextButton", screenGui)
    btn.Size = UDim2.new(0, 75, 0, 75)
    btn.Position = pos
    btn.Text = text
    btn.Font = Enum.Font.GothamBold
    btn.TextSize = 18
    btn.TextColor3 = Color3.fromRGB(0, 0, 0)
    btn.BackgroundColor3 = color
    Instance.new("UICorner", btn).CornerRadius = UDim.new(1, 0)
    
    local st = Instance.new("UIStroke", btn)
    st.Thickness = 3
    st.Color = Color3.new(1, 1, 1)
    
    return btn
end

local toggleBtn = createCircleBtn("RUN", UDim2.new(0.85, -75, 0.4, 0), Color3.fromRGB(0, 255, 150))
local infoBtn = createCircleBtn("FIX", UDim2.new(0.85, -75, 0.55, 0), Color3.fromRGB(255, 200, 0))

-- 4. HÀM NHẤN PHÍM CƠ CHẾ HOLD (ĐỂ KHÔNG BỊ NUỐT CHIÊU)
local function press(key)
    -- Thử cả hai phương thức để đảm bảo mobile nhận diện
    if keypress then keypress(Enum.KeyCode[key]) end
    VirtualInputManager:SendKeyEvent(true, Enum.KeyCode[key], false, game)
    
    task.wait(holdTime) -- Giữ ph_ím đủ lâu để game nhận
    
    if keyrelease then keyrelease(Enum.KeyCode[key]) end
    VirtualInputManager:SendKeyEvent(false, Enum.KeyCode[key], false, game)
end

-- 5. VÒNG LẶP CHÍNH (THEO THỨ TỰ)
task.spawn(function()
    while true do
        if enabled then
            -- A. Auto Click ở giữa màn hình
            local midX = camera.ViewportSize.X / 2
            local midY = camera.ViewportSize.Y / 2
            for i = 1, 3 do
                VirtualInputManager:SendMouseButtonEvent(midX, midY, 0, true, game, 1)
                VirtualInputManager:SendMouseButtonEvent(midX, midY, 0, false, game, 1)
            end

            -- B. Combo theo thứ tự Z -> X -> C
            press("Z")
            task.wait(comboDelay)
            
            press("X")
            task.wait(comboDelay)
            
            press("C")
            task.wait(comboDelay)
        end
        RunService.Heartbeat:Wait()
    end
end)

-- Sự kiện Toggle
local function toggle()
    enabled = not enabled
    toggleBtn.Text = enabled and "STOP" or "RUN"
    toggleBtn.BackgroundColor3 = enabled and Color3.fromRGB(255, 50, 50) or Color3.fromRGB(0, 255, 150)
end

toggleBtn.MouseButton1Click:Connect(toggle)
infoBtn.MouseButton1Click:Connect(function()
    print("Script đang hoạt động mượt mà - Hưng/ Bôn =))")
end)

-- PC Toggle phím E
UserInputService.InputBegan:Connect(function(i, p)
    if not p and i.KeyCode == Enum.KeyCode.E then toggle() end
end)

