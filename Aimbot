local AVOID_TOGGLE_KEY = Enum.KeyCode.KeypadFour
local TARGET_PART_KEY = Enum.KeyCode.KeypadFive
local LOCK_TARGET_KEY = Enum.KeyCode.KeypadSix -- PHÍM MỚI

-- Thông số
local FOV_RADIUS = 300 
local MAX_ESP_DISTANCE = 1500
local FLY_HEIGHT, FLY_SPEED = 15, 75
local AVOID_RANGE, AVOID_SMOOTHNESS = 25, 0.1
local TEAM_CHECK, ESP_ENABLED, WALL_CHECK_ENABLED = false, false, true
local FOV_ENABLED, INVIS_CHECK_ENABLED, FLY_TOP_ENABLED, AVOID_ENABLED = true, true, false, false
local CFRAME_SPEED = 0 
local LockedTarget = nil -- Biến ghim mục tiêu

local TargetParts = {"Head", "UpperTorso", "LowerTorso", "LeftFoot"}
local CurrentPartIndex = 1

-- Vẽ FOV (RGB)
local FOV_Circle = Drawing.new("Circle")
FOV_Circle.Thickness = 1.5
FOV_Circle.Transparency = 0.8
FOV_Circle.Visible = FOV_ENABLED
FOV_Circle.Radius = FOV_RADIUS

