local SliderLabel = Instance.new("TextLabel", SliderFrame); SliderLabel.Size = UDim2.new(1,0,0,20); SliderLabel.Text = "FOV Radius: 300"; SliderLabel.TextColor3 = Color3.new(1,1,1); SliderLabel.BackgroundTransparency = 1; SliderLabel.TextSize = 10
local SliderBtn = Instance.new("TextButton", SliderFrame); SliderBtn.Position = UDim2.new(0.1, 0, 0.5, 0); SliderBtn.Size = UDim2.new(0.8, 0, 0, 10); SliderBtn.Text = ""; SliderBtn.BackgroundColor3 = Color3.new(0.2,0.2,0.2)

