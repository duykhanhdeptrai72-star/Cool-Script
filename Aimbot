-- Logic kiểm tra người chơi
local function IsInvis(player)
    if not player.Character then return false end
    for _, part in pairs(player.Character:GetChildren()) do
        if part:IsA("BasePart") and part.Transparency > 0.5 then return true end
    end
    return false
end

local function getClosest()
    if not FOV_ENABLED then return nil end
    local target, invisTarget, dist, invisDist = nil, nil, FOV_RADIUS, FOV_RADIUS
    
    for _, p in pairs(Players:GetPlayers()) do
        if p ~= LocalPlayer and p.Character then
            -- Kiểm tra xem bộ phận cần nhắm tới có tồn tại không
            local targetPart = p.Character:FindFirstChild(AIM_TARGET_PART) or p.Character:FindFirstChild("HumanoidRootPart")
            
            if targetPart then
                if TEAM_CHECK and p.Team == LocalPlayer.Team then continue end
                
                local pos, onScreen = Camera:WorldToViewportPoint(targetPart.Position)
                if onScreen then
                    local mag = (Vector2.new(pos.X, pos.Y) - UserInputService:GetMouseLocation()).Magnitude
                    if mag < FOV_RADIUS then
                        if INVIS_CHECK_ENABLED and IsInvis(p) then
                            if mag < invisDist then invisTarget = targetPart; invisDist = mag end
                        elseif mag < dist then
                            target = targetPart; dist = mag
                        end
                    end
                end
            end
        end
    end
    return invisTarget or target
end

-- Bắt sự kiện bàn phím
UserInputService.InputBegan:Connect(function(input)
    if input.KeyCode == AIM_PART_TOGGLE_KEY then
        -- Toggle Head <-> HumanoidRootPart
        AIM_TARGET_PART = (AIM_TARGET_PART == "Head") and "HumanoidRootPart" or "Head"
    elseif input.KeyCode == AVOID_TOGGLE_KEY then
        AVOID_ENABLED = not AVOID_ENABLED
    elseif input.KeyCode == FLY_TOP_TOGGLE_KEY then
        FLY_TOP_ENABLED = not FLY_TOP_ENABLED
    elseif input.KeyCode == FOV_TOGGLE_KEY then
        FOV_ENABLED = not FOV_ENABLED; FOV_Circle.Visible = FOV_ENABLED
    elseif input.KeyCode == INVIS_CHECK_KEY then
        INVIS_CHECK_ENABLED = not INVIS_CHECK_ENABLED
    elseif input.KeyCode == SPEED_UP_KEY then
        CFRAME_SPEED = CFRAME_SPEED + (10/60)
    elseif input.KeyCode == SPEED_DOWN_KEY then
        CFRAME_SPEED = math.max(0, CFRAME_SPEED - (10/60))
    elseif input.KeyCode == GUI_KEY then
        ScreenGui.Enabled = not ScreenGui.Enabled
    elseif input.KeyCode == Enum.KeyCode.P then
        TEAM_CHECK = not TEAM_CHECK; FOV_Circle.Color = TEAM_CHECK and Color3.new(0,1,0) or Color3.new(1,1,0)
    end
    UpdateGUI()
end)

-- Vòng lặp chính
RunService.RenderStepped:Connect(function(deltaTime)
    if FOV_ENABLED then FOV_Circle.Position = UserInputService:GetMouseLocation() end
    
    local myChar = LocalPlayer.Character
    local myHRP = myChar and myChar:FindFirstChild("HumanoidRootPart")
    
    if myHRP then
        -- 1. CFRAME SPEED
        local hum = myChar:FindFirstChildOfClass("Humanoid")
        if hum and hum.MoveDirection.Magnitude > 0 then
            myHRP.CFrame = myHRP.CFrame + (hum.MoveDirection * CFRAME_SPEED)
        end

        -- 2. FLY ABOVE
        if FLY_TOP_ENABLED then
            local t = getClosest()
            if t then
                local goal = t.Position + Vector3.new(0, FLY_HEIGHT, 0)
                local dir = (goal - myHRP.Position)
                if dir.Magnitude > 0.5 then
                    myHRP.CFrame = CFrame.new(myHRP.Position + dir.Unit * math.min(dir.Magnitude, FLY_SPEED * deltaTime), t.Position)
                end
            end
        end

        -- 3. AVOID PEOPLE
        if AVOID_ENABLED then
            for _, p in pairs(Players:GetPlayers()) do
                if p ~= LocalPlayer and p.Character and p.Character:FindFirstChild("HumanoidRootPart") then
                    if TEAM_CHECK and p.Team == LocalPlayer.Team then continue end
                    
                    local otherHRP = p.Character.HumanoidRootPart
                    local dist = (myHRP.Position - otherHRP.Position).Magnitude
                    
                    if dist < AVOID_RANGE then
                        local pushDir = (myHRP.Position - otherHRP.Position).Unit
                        myHRP.CFrame = myHRP.CFrame + (pushDir * AVOID_STRENGTH)
                    end
                end
            end
        end
    end

    -- 4. AIMBOT
    if FOV_ENABLED and UserInputService:IsMouseButtonPressed(AIM_KEY) then
        local t = getClosest()
        if t then 
            Camera.CFrame = CFrame.new(Camera.CFrame.Position, t.Position) 
        end
    end
end)

UpdateGUI() -- Khởi tạo text lần đầu
