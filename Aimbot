local l_lock = CreateBindLabel("Num6 - TargetLock: NONE")
local l_part = CreateBindLabel("Num5 - Target: Head")
local l_avoid = CreateBindLabel("Num4 - Avoid: OFF")
local l_fly = CreateBindLabel("Num3 - Fly Above: OFF")
local l_invis = CreateBindLabel("Num2 - AntiInvis: ON")
local l_fov = CreateBindLabel("Num1 - Aim/FOV: ON")
local l_esp = CreateBindLabel("E - ESP: OFF")

-- Slider Logic
SliderBtn.MouseButton1Down:Connect(function()
    local move = RunService.RenderStepped:Connect(function()
        local mousePos = UserInputService:GetMouseLocation().X
        local relativePos = math.clamp((mousePos - SliderBtn.AbsolutePosition.X) / SliderBtn.AbsoluteSize.X, 0, 1)
        FOV_RADIUS = math.floor(relativePos * 800)
        FOV_Circle.Radius = FOV_RADIUS
        SliderLabel.Text = "FOV Radius: " .. FOV_RADIUS
    end)
    UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then move:Disconnect() end
    end)
end)

local function UpdateGUI()
    l_lock.Text = "  Num6 - TargetLock: " .. (LockedTarget and LockedTarget.Parent.Name or "NONE")
    l_lock.TextColor3 = LockedTarget and Color3.new(1,1,0) or Color3.new(1,1,1)
    l_part.Text = "  Num5 - Target: " .. TargetParts[CurrentPartIndex]
    l_avoid.Text = "  Num4 - Avoid: " .. (AVOID_ENABLED and "ON" or "OFF")
    l_fly.Text = "  Num3 - Fly Above: " .. (FLY_TOP_ENABLED and "ON" or "OFF")
    l_fov.Text = "  Num1 - Aim/FOV: " .. (FOV_ENABLED and "ON" or "OFF")
    l_esp.Text = "  E - ESP: " .. (ESP_ENABLED and "ON" or "OFF")
end

-- Logic tìm mục tiêu
local function getClosest()
    if LockedTarget and LockedTarget.Parent and LockedTarget.Parent:FindFirstChild("Humanoid") and LockedTarget.Parent.Humanoid.Health > 0 then
        return LockedTarget
    end
    LockedTarget = nil -- Reset nếu mục tiêu ghim đã chết/thoát
    
    local target, dist = nil, FOV_RADIUS
    for _, p in pairs(Players:GetPlayers()) do
        if p ~= LocalPlayer and p.Character then
            if TEAM_CHECK and p.Team == LocalPlayer.Team then continue end
            local part = p.Character:FindFirstChild(TargetParts[CurrentPartIndex]) or p.Character:FindFirstChild("HumanoidRootPart")
            if part then
                local pos, onScreen = Camera:WorldToViewportPoint(part.Position)
                if onScreen then
                    local mag = (Vector2.new(pos.X, pos.Y) - UserInputService:GetMouseLocation()).Magnitude
                    if mag < dist then target, dist = part, mag end
                end
            end
        end
    end
    return target
end

-- Keyboard Events
UserInputService.InputBegan:Connect(function(input)
    if input.KeyCode == LOCK_TARGET_KEY then
        if LockedTarget then LockedTarget = nil
        else LockedTarget = getClosest() end
    elseif input.KeyCode == TARGET_PART_KEY then CurrentPartIndex = CurrentPartIndex % #TargetParts + 1
    elseif input.KeyCode == AVOID_TOGGLE_KEY then AVOID_ENABLED = not AVOID_ENABLED
    elseif input.KeyCode == FLY_TOP_TOGGLE_KEY then FLY_TOP_ENABLED = not FLY_TOP_ENABLED
    elseif input.KeyCode == FOV_TOGGLE_KEY then FOV_ENABLED = not FOV_ENABLED; FOV_Circle.Visible = FOV_ENABLED
    elseif input.KeyCode == ESP_KEY then ESP_ENABLED = not ESP_ENABLED
    elseif input.KeyCode == GUI_KEY then ScreenGui.Enabled = not ScreenGui.Enabled
    end
    UpdateGUI()
end)

-- Main Loop
RunService.RenderStepped:Connect(function(dt)
    -- RGB FOV
    local hue = tick() % 5 / 5
    FOV_Circle.Color = Color3.fromHSV(hue, 1, 1)
    UIStroke.Color = Color3.fromHSV(hue, 1, 1)
    if FOV_ENABLED then FOV_Circle.Position = UserInputService:GetMouseLocation() end
    
    local myChar = LocalPlayer.Character
    local myHRP = myChar and myChar:FindFirstChild("HumanoidRootPart")
    
    if myHRP then
        -- Smooth Avoidance
        if AVOID_ENABLED then
            local separation = Vector3.zero
            for _, p in pairs(Players:GetPlayers()) do
                if p ~= LocalPlayer and p.Character and p.Character:FindFirstChild("HumanoidRootPart") then
                    if TEAM_CHECK and p.Team == LocalPlayer.Team then continue end
                    local diff = myHRP.Position - p.Character.HumanoidRootPart.Position
                    if diff.Magnitude < AVOID_RANGE then separation = separation + (diff.Unit * (AVOID_RANGE - diff.Magnitude)) end
                end
            end
            myHRP.CFrame = myHRP.CFrame:Lerp(myHRP.CFrame + separation, AVOID_SMOOTHNESS)
        end

        -- Fly Above & TargetLock Aimbot
        local t = getClosest()
        if FLY_TOP_ENABLED and t then
            myHRP.CFrame = myHRP.CFrame:Lerp(CFrame.new(t.Position + Vector3.new(0, FLY_HEIGHT, 0), t.Position), 0.1)
        end
        
        if FOV_ENABLED and t and UserInputService:IsMouseButtonPressed(AIM_KEY) then
            Camera.CFrame = Camera.CFrame:Lerp(CFrame.new(Camera.CFrame.Position, t.Position), 0.15)
        end
    end
end)
