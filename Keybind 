local Symbols = {
    ["/ (Slash)"] = Enum.KeyCode.Slash,
    [", (Comma)"] = Enum.KeyCode.Comma,
    [". (Period)"] = Enum.KeyCode.Period,
    ["; (Semicolon)"] = Enum.KeyCode.Semicolon,
    ["[ (LeftBracket)"] = Enum.KeyCode.LeftBracket,
    ["] (RightBracket)"] = Enum.KeyCode.RightBracket,
    ["' (Quote)"] = Enum.KeyCode.Quote,
    ["- (Minus)"] = Enum.KeyCode.Minus,
    ["= (Equals)"] = Enum.KeyCode.Equals
}

local function addKey(name, code)
    local k = Instance.new("TextButton")
    k.Size = UDim2.new(1, -10, 0, 30)
    k.Text = name
    k.Name = name:lower()
    k.BackgroundColor3 = Color3.fromRGB(45, 45, 45)
    k.TextColor3 = Color3.new(1, 1, 1)
    k.Parent = Scroll
    local c = Instance.new("UICorner") ; c.CornerRadius = UDim.new(0, 5) ; c.Parent = k
    
    k.MouseButton1Click:Connect(function()
        if HoldingKeys[code] then
            HoldingKeys[code] = false
            k.BackgroundColor3 = Color3.fromRGB(45, 45, 45)
            VirtualInputManager:SendKeyEvent(false, code, false, game)
        else
            HoldingKeys[code] = true
            k.BackgroundColor3 = Color3.fromRGB(0, 120, 255)
            task.spawn(function()
                while HoldingKeys[code] do
                    VirtualInputManager:SendKeyEvent(true, code, false, game)
                    task.wait(0.1)
                end
            end)
        end
    end)
end

-- Load Full Keybinds
for n, c in pairs(Symbols) do addKey(n, c) end
for _, key in ipairs(Enum.KeyCode:GetEnumItems()) do
    if key.Name ~= "Unknown" and not string.find(key.Name, "Button") then
